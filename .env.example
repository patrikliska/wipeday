# Copy to .env and fill in. .env is gitignored: never commit it.

# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=
# The one server the bot runs in. Commands are registered to this guild only,
# so they appear instantly.
DISCORD_GUILD_ID=
# Where story-worthy events are posted (used from Phase 3).
FEED_CHANNEL_ID=
# Optional: a role whose members may use admin commands (/idle-debug, /idle-admin)
# in addition to server Administrators.
ADMIN_ROLE_ID=
# SQLite file. The folder is created on startup.
DATABASE_PATH=var/wipe-day.db
