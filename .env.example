# Copy to .env and fill in. .env is gitignored: never commit it.

# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=
# The one server the bot runs in. Commands are registered to this guild only,
# so they appear instantly.
DISCORD_GUILD_ID=
# Where story-worthy events are posted (used from Phase 3).
FEED_CHANNEL_ID=
# Optional: a role whose members may use admin commands (/idle-debug, /idle-admin)
# in addition to server Administrators.
ADMIN_ROLE_ID=
# SQLite file. The folder is created on startup.
DATABASE_PATH=var/wipe-day.db

# --- The game server (apps/api) ------------------------------------------------
# Discord login: the same application as the bot. OAuth2 -> Client Secret, and add the redirect
# {PUBLIC_URL}/api/auth/callback under OAuth2 -> Redirects. Without these, only the dev test
# players can log in (and only outside production).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Where players open the game (the OAuth redirect and cookies are built from it).
PUBLIC_URL=http://localhost:5173
API_PORT=8787
# The game's SQLite file (separate from the bot's DATABASE_PATH above).
GAME_DATABASE_PATH=var/wipeday.db
