# Copy to .env and fill in. .env is gitignored: never commit it.

# --- The game server (apps/api) ------------------------------------------------
# Discord login: the bot's application. OAuth2 -> Client Secret, and add the redirect
# {PUBLIC_URL}/api/auth/callback under OAuth2 -> Redirects. Without these, only the dev test
# players can log in (and only outside production).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Where players open the game (the OAuth redirect, cookies and the bot's links are built from it).
PUBLIC_URL=http://localhost:5173
API_PORT=8787
# The game's SQLite file: the only database (the bot keeps none since W8).
GAME_DATABASE_PATH=var/wipeday.db
# The token the Discord bot uses to reach the API (32+ random characters, the same for both).
# Required in production; a development API lets the bot in without it.
BOT_API_TOKEN=

# --- The Discord bot (apps/discord) -------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=
# The one server the bot runs in. /base is registered to this guild only, so it appears instantly.
DISCORD_GUILD_ID=
# Where the island's feed and season news are posted. Empty: not posted.
FEED_CHANNEL_ID=
# The game server the bot talks to (on the VPS: http://wipeday:8787, set in compose.yml).
API_URL=http://localhost:8787
