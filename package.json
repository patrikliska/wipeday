{
  "name": "wipe-day",
  "version": "0.1.0",
  "private": true,
  "description": "Wipe Day: an idle survival game. Web client, API, shared domain, Discord companion.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "start": "pnpm --filter @wipe-day/discord start",
    "dev": "pnpm --parallel --filter @wipe-day/api --filter @wipe-day/web dev",
    "bot:dev": "pnpm --filter @wipe-day/discord dev",
    "preview": "pnpm --filter @wipe-day/discord preview",
    "assets": "pnpm --filter @wipe-day/discord assets",
    "db:generate": "pnpm --filter @wipe-day/discord db:generate",
    "sim": "pnpm --filter @wipe-day/sim sim",
    "api": "pnpm --filter @wipe-day/api start",
    "web": "pnpm --filter @wipe-day/web dev",
    "web:build": "pnpm --filter @wipe-day/web build",
    "web:typecheck": "pnpm --filter @wipe-day/web typecheck",
    "web:shots": "pnpm --filter @wipe-day/web shots",
    "api:dev": "pnpm --filter @wipe-day/api dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
