// Active play between gathers.
{
  // Work the node: tap the marker up to `maxHits` times; each hit must land within
  // `hitWindowSeconds` of the previous one (the server allows `graceSeconds` more for
  // network lag). A full run earns `perfectBonusHits` extra slices.
  // The daily haul: hits pay in full until they have brought in `dailyHaulMinutes` of
  // production today (UTC), then `afterHaulPercent` of it. Tapping stays fun; farming has a ceiling.
  node: {
    maxHits: 5,
    hitWindowSeconds: 4.5,
    graceSeconds: 3,
    perfectBonusHits: 1,
    dailyHaulMinutes: 180,
    afterHaulPercent: 10,
  },
  // A barrel washes up on a fixed schedule and drifts off if nobody breaks it.
  barrels: {
    firstAfterMinutes: 15,
    everyMinutes: 240,
    expiresMinutes: 45,
    rolls: 2,
    loot: [
      { resource: "scrap", min: 2, max: 8, weight: 30 },
      { resource: "fibre", min: 10, max: 30, weight: 25 },
      { resource: "hide", min: 5, max: 15, weight: 15 },
      { resource: "fat", min: 3, max: 8, weight: 10 },
      { resource: "food", min: 10, max: 30, weight: 15 },
    ],
  },
  // Daily tasks: the same picks for everyone each UTC day; ones a base cannot do yet are skipped.
  tasks: {
    perDay: 3,
    pool: [
      { id: "gather_4", kind: "gather", target: 4, reward: { scrap: 5, timber: 200 } },
      { id: "collect_3", kind: "collect", target: 3, reward: { scrap: 5, stone: 200 } },
      { id: "node_hits_10", kind: "node_hits", target: 10, reward: { scrap: 10 } },
      { id: "barrel_1", kind: "barrel", target: 1, reward: { scrap: 5, fibre: 20 } },
      { id: "smelt_300", kind: "smelt", target: 300, requires: "furnace", reward: { scrap: 10, ingots: 50 } },
      { id: "furnace_out_200", kind: "furnace_collect", target: 200, requires: "furnace", reward: { scrap: 8 } },
      { id: "craft_1", kind: "craft", target: 1, requires: "workbench", reward: { scrap: 10, timber: 300 }, blueprint: true },
    ],
  },
}
