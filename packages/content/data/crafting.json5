// How production works at the stations (the workbench, loom, tannery, kiln, oil press and
// the campfire's kitchen). Lists are per station level: index 0 = level 1.
{
  // Jobs a station holds, the one being made included.
  queueSlots: [2, 3, 4],
  // The most units in one job ("craft all you can" stops here).
  batchSize: [10, 25, 50],
  // Salvage gives back this share of the item's recipe cost, rounded down...
  salvagePercent: 40,
  // ...plus this much scrap, by the item's tier.
  salvageScrap: { twig: 1, wood: 2, stone: 4, metal: 8, hqm: 15 },
  blueprints: {
    // A broken barrel also holds a blueprint this often (while any are left to find).
    // With about three barrels a day that is one every few days; the daily craft task
    // (active.json5) is the steady source.
    barrelPercent: 8,
    // A perfect node run turns one up this often.
    perfectRunPercent: 3,
  },
}
