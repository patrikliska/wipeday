// Grip, the tool ladder (docs/redesign/02-the-run.md 5.2): Rock is owned from the start; each
// rung after it doubles the flat tap and adds 0.4% of the full rate to every tap. The effects
// are per rung, so a pocketed rung (R7) works out of order. `tier` is the era colour a tool
// wears, not a gate. Names: `tool.{id}.name`.
{
  tools: [
    { id: "rock", tier: "twig", cost: 0 },
    {
      id: "stone_tools",
      tier: "wood",
      // 100, not 60: with base output 0.42 the crown would save for it before the first
      // Beachcomber (6), and the first card would come uncrowned (R2 Feel S6, D233).
      cost: 100,
      pocket: true,
      effects: [
        { stat: "tap_flat", op: "more", value: 2 },
        { stat: "tap_share", op: "add", value: 0.004 },
      ],
    },
    {
      id: "iron_tools",
      tier: "stone",
      cost: 6e3,
      pocket: true,
      effects: [
        { stat: "tap_flat", op: "more", value: 2 },
        { stat: "tap_share", op: "add", value: 0.004 },
      ],
    },
    {
      id: "salvaged_tools",
      tier: "metal",
      cost: 6e6,
      pocket: true,
      effects: [
        { stat: "tap_flat", op: "more", value: 2 },
        { stat: "tap_share", op: "add", value: 0.004 },
      ],
    },
    {
      id: "power_tools",
      tier: "hqm",
      cost: 6e9,
      pocket: true,
      effects: [
        { stat: "tap_flat", op: "more", value: 2 },
        { stat: "tap_share", op: "add", value: 0.004 },
      ],
    },
  ],
}
