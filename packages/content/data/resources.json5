// The currencies and the lines' products (D131). Names live in locale/en.json
// (`resource.{id}.name`); icons in icons/currency/ and icons/product/ (D141).
// kind: currency = held and spent (supplies in the run; glass and scrap kept forever; sea
// charts reserved for the Crossing). product = what a line makes and sells at once for
// supplies: drawn and badged, never stocked or spent (amendment A1).
{
  resources: [
    { id: "supplies", kind: "currency" },
    { id: "glass", kind: "currency" },
    { id: "scrap", kind: "currency" },
    { id: "sea_charts", kind: "currency" },
    // One per line, in rung order (docs/redesign/02-the-run.md 1.1).
    { id: "timber", kind: "product" },
    { id: "roast", kind: "product" },
    { id: "fibre", kind: "product" },
    { id: "rope", kind: "product" },
    { id: "planks", kind: "product" },
    { id: "charcoal", kind: "product" },
    { id: "ingots", kind: "product" },
    { id: "leather", kind: "product" },
    { id: "fuel", kind: "product" },
    { id: "food", kind: "product" },
    { id: "battery", kind: "product" },
    { id: "broadcast", kind: "product" },
    { id: "plates", kind: "product" },
    { id: "cell", kind: "product" },
  ],
}
