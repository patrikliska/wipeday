// Everything the base stores, in display order. Names live in locale/en.json
// (`resource.{id}.name`); colours and icons live with the web client.
// kind: raw = gathered, refined = made from a raw one (`smeltsInto`, 1:1 in a furnace),
// currency = scrap. Fat renders into fuel in the furnace until the oil press gets its job (W3).
{
  resources: [
    { id: "timber", kind: "raw" },
    { id: "stone", kind: "raw" },
    { id: "ore", kind: "raw", smeltsInto: "ingots" },
    { id: "ingots", kind: "refined" },
    { id: "sulfur_ore", kind: "raw", smeltsInto: "sulfur" },
    { id: "sulfur", kind: "refined" },
    { id: "fibre", kind: "raw" },
    { id: "hide", kind: "raw" },
    { id: "fat", kind: "raw", smeltsInto: "fuel" },
    { id: "fuel", kind: "refined" },
    { id: "scrap", kind: "currency" },
  ],
}
