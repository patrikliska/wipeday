// Targets the simulator asserts (`pnpm sim check`). Days are season days
// (day 1 = the first 24 hours). docs/game-design.md section 6; tiers are Stone, Sheet Metal (metal), Armored (hqm).
{
  // Casual player, 3 check-ins a day.
  casual: {
    stone: { earliestDay: 3, latestDay: 4 },
    metal: { earliestDay: 12, latestDay: 14 },
    hqm: { earliestDay: 15, latestDay: 28 },
    // The base fills up: buildings standing by the end of the first week (roadmap W2).
    buildings: { day: 7, count: 6 },
    // Crafting throughput (roadmap W3): the first of each made by this season day...
    firstMade: { planks: 2, bow: 3, leather: 9, plates: 10, springs: 18 },
    // ...and every station has made something by this day.
    stationsWorkedByDay: 14,
  },
  // The greedy planner with hourly check-ins must not beat these.
  optimal: {
    hqmNotBeforeDay: 14,
  },
  // Each tier costs roughly this much more than the previous one (by resource-hours).
  tierCostRatio: { min: 3, max: 6 },
}
