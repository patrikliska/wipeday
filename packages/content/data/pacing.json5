// Targets the simulator asserts (`pnpm sim check`). Days are season days
// (day 1 = the first 24 hours). docs/game-design.md section 6; tiers are Stone, Sheet Metal (metal), Armored (hqm).
{
  // Casual player, 3 check-ins a day.
  casual: {
    stone: { earliestDay: 3, latestDay: 4 },
    metal: { earliestDay: 12, latestDay: 14 },
    hqm: { earliestDay: 15, latestDay: 28 },
    // The base fills up: buildings standing by the end of the first week (roadmap W2).
    buildings: { day: 7, count: 6 },
    // Crafting throughput (roadmap W3): the first of each made by this season day...
    firstMade: { planks: 2, bow: 4, leather: 9, plates: 10, springs: 18 },
    // ...and every station has made something by this day.
    stationsWorkedByDay: 14,
    // Expeditions (roadmap W4a): the first party out, the first tier-3 site, the crew growing,
    // and site scrap paying for the salvaged tools.
    firstTripByDay: 2,
    tierThreeSiteByDay: 14,
    // W4b: someone on a job early, and the far north and the sea within the season.
    jobsByDay: 3,
    tierFourSiteByDay: 26,
    tierFiveSiteByDay: 31,
    crew: { day: 10, count: 5 },
    tool: { id: "salvaged_tools", byDay: 18 },
    // W5: scrap rises slowly. On this day the casual player holds between min and max:
    // enough to use the Den, not a pile with nothing to buy.
    scrap: { day: 28, min: 800, max: 4000 },
  },
  // W5: the gambler plays the biggest bet up to the daily cap at every check-in. Its scrap
  // never goes negative and no day's wagers pass that day's cap (asserted in the check).
  // The greedy planner with hourly check-ins must not beat these.
  optimal: {
    hqmNotBeforeDay: 14,
    tierThreeSiteNotBeforeDay: 7,
    // The end of the site chain (the season's peak) never before this day.
    lastSite: { id: "offshore_platform", notBeforeDay: 18 },
  },
  // Each tier costs roughly this much more than the previous one (by resource-hours).
  tierCostRatio: { min: 3, max: 6 },
}
