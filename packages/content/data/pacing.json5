// Simulator v2's archetypes and the targets it asserts (`pnpm sim check`; the `test` profile
// runs inside `pnpm test`). D129, D144; docs/redesign/10-balance.md 7.4. Times are wall clock
// from the player's first tap; "day N" is the N-th calendar day of play (UTC).
//
// Every assertion names its canon number and the phase that switches it on (`on`). Assertions
// on or before `shipped` must pass (a test fails if one has no implementation); later ones are
// listed so the plan is visible in one place. `warn: true` prints WARN instead of failing.
{
  shipped: "R0",
  profiles: {
    test: { days: 90, seeds: [11] },
    full: { days: 365, seeds: [7, 11, 23] },
  },
  // Sessions: "HH:MM+Nm" every day (UTC), or "hourly+Nm". Taps a second while a session runs;
  // `tapsWhileNothingRuns` taps only while no line runs by itself (the idler); `catches` is the
  // share of the flotsam floating while online that it catches.
  archetypes: {
    idler: { sessions: ["08:00+3m", "21:00+3m"], tapsPerSecond: 0, tapsWhileNothingRuns: 4, nuke: "double" },
    casual: { sessions: ["08:00+5m", "13:00+5m", "21:00+5m"], tapsPerSecond: 4, catches: 0.5, nuke: "crown" },
    active: {
      sessions: ["07:00+10m", "09:00+10m", "12:00+10m", "15:00+10m", "17:00+10m", "19:00+10m", "21:00+10m", "23:00+10m"],
      tapsPerSecond: 6,
      catches: 1,
      nuke: "crown",
    },
    optimal: { sessions: ["hourly+5m"], tapsPerSecond: 6, catches: 1, nuke: "best" },
    lateJoiner: { sessions: ["08:00+5m", "13:00+5m", "21:00+5m"], tapsPerSecond: 4, catches: 0.5, nuke: "crown", startDay: 30 },
  },
  // One long session from the first tap.
  scenarios: {
    firstHour: { sessions: ["00:00+180m"], tapsPerSecond: 6, catches: 1, nuke: "crown" },
    autoclicker: { sessions: ["00:00+180m"], tapsPerSecond: 15, catches: 1, nuke: "crown" },
  },
  assertions: [
    // R0: the shape of the numbers.
    { n: "N21", on: "R0", check: "prestigeShape", exponent: 0.2, l0: 5e5, glowK: 0.25, firstNukeGlass: 10 },
    { n: "N23", on: "R0", check: "magnitude", max: 1e150 },
    // R1: the run.
    { n: "N4", on: "R1", check: "firstHandSeconds", max: 120 },
    { n: "N5", on: "R1", check: "nothingAffordableEarly", maxSeconds: 30, runs: 5, onlineMinutes: 10 },
    { n: "N6", on: "R1", check: "nothingAffordableOnline", maxSeconds: 120, runs: 5 },
    { n: "N7", on: "R1", check: "casualCheckInsWithPurchase", min: 1, days: 1 },
    { n: "N8", on: "R1", check: "tapShare", firstMinuteMin: 0.5, fromMinute10: [0.05, 0.25] },
    // N9 on the weather-weighted hour; a rain hour alone only warns (errata E13).
    { n: "N9", on: "R1", check: "activeHour", days: [14, 30, 60], min: 1.5, max: 3 },
    { n: "N9", on: "R1", check: "activeHour", days: [14, 30, 60], rain: true, min: 1.5, max: 3, warn: true },
    { n: "N23", on: "R1", check: "run1Made", min: 1e10, max: 1e12 },
    // Run 1's script (10-balance.md 4.2, errata E1's column), seconds after the first tap: Timber
    // 0:36, Mara 0:41, the crate 3:00, Sorting Tables 3:01, Stone 4:30, Sheet Metal 42:38, the
    // first nuke about 46-48 minutes (N1's 40-60 is R2's).
    {
      n: "4.2",
      on: "R1",
      check: "firstHourBeats",
      scenario: "firstHour",
      beats: {
        era_wood: [25, 60],
        hand: [30, 120],
        flotsam: [180, 185],
        sorting_tables: [150, 300],
        era_stone: [210, 420],
        era_metal: [1800, 3000],
        nuke: [2400, 3600],
      },
    },
    // R2: the nuke.
    { n: "N1", on: "R2", check: "firstNukeMinutes", scenario: "firstHour", min: 40, max: 60 },
    { n: "N2", on: "R2", check: "firstNukeMinutesAny", min: 25 },
    { n: "N3", on: "R2", check: "casualFirstNuke", day: 1, by: "21:00" },
    { n: "N7", on: "R2", check: "casualCheckInsWithPurchase", min: 0.9, days: 30 },
    { n: "N11", on: "R2", check: "passPreviousRun", early: 0.65, mid: 0.95, late: 1, warn: true },
    { n: "N12", on: "R2", check: "powerPerNuke", early: [1.5, 2.5], mid: [1.15, 1.6], late: [1.1, 1.5] },
    { n: "N13", on: "R2", check: "flattening", window: 5, minProduct: 1.3, unlockLookahead: 3 },
    { n: "N14", on: "R2", check: "nodesBought", first: [6, 10], laterMedianMin: 2 },
    { n: "4.10", on: "R2", check: "casualWipeDaysByDay30", min: 20, max: 40 },
    { n: "4.10", on: "R2", check: "casualFirstWeekGlass", min: 300, max: 2000 },
    // R3 on: the tree, the gaps, the slow layer, friends.
    { n: "N15", on: "R3", check: "treeHorizon", optimalLitDay30Max: 0.45, fullNotBeforeDay: 90 },
    { n: "N15", on: "R3", check: "casualLitDay180", min: 0.45, warn: true },
    { n: "N16", on: "R3", check: "gaps", profile: "g5", days: [30, 90], activeMax: 2, optimalMax: 2.5, idlerMin: 0.5 },
    { n: "N16", on: "R3", check: "gapsAlone", days: [30, 90], activeMax: 2, optimalMax: 2.5, idlerMin: 0.5, warn: true },
    { n: "5.7", on: "R3", check: "casualRunDaysAfterDay30", max: 3, warn: true },
    { n: "N19", on: "R5", check: "scrap", casualMean: [0.8, 2], casualByDay30: 25, anyMeanMax: 2.5 },
    { n: "N17", on: "R6", check: "lateJoiner", withinDays: 12 },
    // R7: N11 becomes a failing assertion.
    { n: "N11", on: "R7", check: "passPreviousRun", early: 0.65, mid: 0.95, late: 1 },
  ],
}
