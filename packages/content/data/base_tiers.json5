// The core of the base, in upgrade order: twig, wood (Timber), stone, metal (Sheet Metal),
// hqm (Armored). The ids are fixed in code (`src/tiers.ts`); display names are in the locale.
// storageCap: room per resource before crates. boxSlots: crates that count. furnaceSlots:
// parallel smelting jobs. workbenchLevel: highest bench usable. buildMinutes: timer after
// paying (0 = instant). upkeep: drained every hour at this tier.
{
  rules: {
    // Production while upkeep is unpaid, as a percentage of normal.
    decayProductionPercent: 50,
    // Unpaid for this long and the base drops one tier.
    tierLossAfterHours: 72,
    // Items waiting in the crafting queue, including the one being made.
    craftQueueSize: 3,
  },
  baseTiers: [
    {
      id: "twig",
      storageCap: 1500, boxSlots: 2, furnaceSlots: 1, workbenchLevel: 1,
      cost: {}, buildMinutes: 0, upkeep: {},
    },
    {
      id: "wood",
      storageCap: 5000, boxSlots: 4, furnaceSlots: 1, workbenchLevel: 1,
      cost: { timber: 1500, stone: 500 }, buildMinutes: 0, upkeep: { timber: 30 },
    },
    {
      id: "stone",
      storageCap: 20000, boxSlots: 8, furnaceSlots: 2, workbenchLevel: 2,
      cost: { stone: 6000, ingots: 800 }, buildMinutes: 240, upkeep: { timber: 40, stone: 100 },
    },
    {
      id: "metal",
      storageCap: 80000, boxSlots: 12, furnaceSlots: 3, workbenchLevel: 3,
      cost: { stone: 40000, ingots: 38000 }, buildMinutes: 720,
      upkeep: { timber: 60, stone: 150, ingots: 60 },
    },
    {
      id: "hqm",
      storageCap: 300000, boxSlots: 16, furnaceSlots: 4, workbenchLevel: 3,
      cost: { ingots: 25000, fuel: 400 }, buildMinutes: 1440,
      upkeep: { timber: 80, stone: 200, ingots: 100, fuel: 2 },
    },
  ],
}
