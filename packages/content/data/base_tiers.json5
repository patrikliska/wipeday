// The core of the base, in upgrade order: twig, wood (Timber), stone, metal (Sheet Metal),
// hqm (Armored). The ids are fixed in code (`src/tiers.ts`); display names are in the locale.
// storageCap: room per resource before crates. boxSlots: crates that count. furnaceSlots:
// parallel smelting jobs. builders: constructions (tier or buildings) running at once.
// buildMinutes: timer after paying (0 = instant). upkeep: drained every hour at this tier.
{
  rules: {
    // Production while upkeep is unpaid, as a percentage of normal.
    decayProductionPercent: 50,
    // Unpaid for this long and the base drops one tier.
    tierLossAfterHours: 72,
  },
  baseTiers: [
    {
      id: "twig",
      storageCap: 1500, boxSlots: 2, furnaceSlots: 1, builders: 1,
      cost: {}, buildMinutes: 0, upkeep: {},
    },
    {
      id: "wood",
      storageCap: 5000, boxSlots: 4, furnaceSlots: 1, builders: 1,
      cost: { timber: 1500, stone: 500 }, buildMinutes: 0, upkeep: { timber: 30 },
    },
    {
      id: "stone",
      storageCap: 20000, boxSlots: 8, furnaceSlots: 2, builders: 2,
      cost: { stone: 6000, ingots: 800, planks: 200 }, buildMinutes: 240, upkeep: { timber: 40, stone: 100 },
    },
    {
      id: "metal",
      storageCap: 80000, boxSlots: 12, furnaceSlots: 3, builders: 2,
      cost: { stone: 40000, ingots: 30000, plates: 300, frames: 100, leather: 40 }, buildMinutes: 720,
      upkeep: { timber: 60, stone: 150, ingots: 60 },
    },
    {
      id: "hqm",
      storageCap: 300000, boxSlots: 16, furnaceSlots: 4, builders: 2,
      cost: { ingots: 20000, plates: 600, gears: 150, springs: 100, fuel: 400 }, buildMinutes: 1440,
      upkeep: { timber: 80, stone: 200, ingots: 100, fuel: 2 },
    },
  ],
}
