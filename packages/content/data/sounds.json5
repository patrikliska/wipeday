// The game's sounds (12-feel.md 3.3; CLAUDE.md 6.2; D224). One map, read only by the web client:
// `events` says what plays on each event the client hears of (`null` is a chosen silence), and
// `cues` says what a cue is: its files (one picked at random per play), the procedural voice
// that plays until a file has decoded (or alone, when it has no files), and its mix.
//
// Files live under apps/web/public/sound/<source>/<name>.ogg and .mp3, built by `pnpm sounds`
// from the packs below (trimmed of leading silence, levelled, cut to `trim`). Swap a sound by
// changing a cue's files and running `pnpm sounds` again; the credits panel lists the sources.
{
  sources: [
    { id: "kenney_impact", url: "https://kenney.nl/assets/impact-sounds", licence: "CC0-1.0" },
    { id: "kenney_interface", url: "https://kenney.nl/assets/interface-sounds", licence: "CC0-1.0" },
    { id: "kenney_rpg", url: "https://kenney.nl/assets/rpg-audio", licence: "CC0-1.0" },
  ],

  cues: {
    // Taps, one per era's target, at most 15 a second (the token bucket's rate).
    tap_tree: {
      voice: "tap",
      files: [
        "kenney_impact/impactWood_light_000",
        "kenney_impact/impactWood_light_001",
        "kenney_impact/impactWood_light_002",
        "kenney_impact/impactWood_light_003",
        "kenney_impact/impactWood_light_004",
      ],
      gain: 0.55,
      detune: 60,
      trim: 0.22,
      perSecond: 15,
    },
    tap_stone: {
      voice: "tap",
      files: [
        "kenney_impact/impactMining_000",
        "kenney_impact/impactMining_001",
        "kenney_impact/impactMining_002",
        "kenney_impact/impactMining_003",
        "kenney_impact/impactMining_004",
      ],
      gain: 0.5,
      detune: 60,
      trim: 0.28,
      perSecond: 15,
    },
    tap_ore: {
      voice: "tap",
      files: [
        "kenney_impact/impactMetal_light_000",
        "kenney_impact/impactMetal_light_001",
        "kenney_impact/impactMetal_light_002",
        "kenney_impact/impactMetal_light_003",
        "kenney_impact/impactMetal_light_004",
      ],
      gain: 0.45,
      detune: 50,
      trim: 0.28,
      perSecond: 15,
    },
    tap_sulfur: {
      voice: "tap",
      files: [
        "kenney_impact/impactSoft_medium_000",
        "kenney_impact/impactSoft_medium_001",
        "kenney_impact/impactSoft_medium_002",
        "kenney_impact/impactSoft_medium_003",
        "kenney_impact/impactSoft_medium_004",
      ],
      gain: 0.6,
      detune: 80,
      trim: 0.2,
      perSecond: 15,
    },
    tap_wreck: {
      voice: "tap",
      files: [
        "kenney_impact/impactPlate_medium_000",
        "kenney_impact/impactPlate_medium_001",
        "kenney_impact/impactPlate_medium_002",
        "kenney_impact/impactPlate_medium_003",
        "kenney_impact/impactPlate_medium_004",
      ],
      gain: 0.42,
      detune: 50,
      trim: 0.3,
      perSecond: 15,
    },
    // A crit rides on its tap: a bright ping.
    crit: {
      voice: "crit",
      files: ["kenney_impact/impactGlass_light_000", "kenney_impact/impactGlass_light_001"],
      gain: 0.55,
      detune: 40,
      perSecond: 6,
    },

    // The target falls: one per target.
    fell_tree: {
      voice: "fell",
      files: [
        "kenney_impact/impactWood_heavy_000",
        "kenney_impact/impactWood_heavy_001",
        "kenney_impact/impactWood_heavy_002",
      ],
      gain: 0.9,
      detune: 30,
    },
    fell_stone: {
      voice: "fell",
      files: [
        "kenney_impact/impactPunch_heavy_000",
        "kenney_impact/impactPunch_heavy_001",
        "kenney_impact/impactPunch_heavy_002",
      ],
      gain: 0.9,
      detune: 30,
    },
    fell_ore: {
      voice: "fell",
      files: ["kenney_impact/impactBell_heavy_000", "kenney_impact/impactBell_heavy_001"],
      gain: 0.6,
      detune: 20,
      trim: 1.2,
    },
    fell_sulfur: {
      voice: "fell",
      files: ["kenney_impact/impactSoft_heavy_000", "kenney_impact/impactSoft_heavy_001"],
      gain: 0.9,
      detune: 30,
    },
    fell_wreck: {
      voice: "fell",
      files: [
        "kenney_impact/impactMetal_heavy_000",
        "kenney_impact/impactMetal_heavy_001",
        "kenney_impact/impactMetal_heavy_002",
      ],
      gain: 0.8,
      detune: 30,
    },

    // Spending: coins for a unit, a latch for a tool or an upgrade, a whistle for a hire.
    buy: {
      voice: "buy",
      files: ["kenney_rpg/handleCoins2"],
      gain: 0.6,
      detune: 80,
      trim: 0.4,
      perSecond: 10,
    },
    upgrade: { voice: "buy", files: ["kenney_rpg/metalLatch"], gain: 0.7, detune: 40 },
    hand: { voice: "hand", gain: 0.9 },
    era: { voice: "era", gain: 0.9 },
    // The next era can be built (D245): a bright two-note, once per era a run.
    era_ready: { voice: "milestone", files: ["kenney_interface/confirmation_002"], gain: 0.55 },
    milestone: { voice: "milestone", files: ["kenney_interface/confirmation_001"], gain: 0.6 },
    roster: { voice: "milestone", files: ["kenney_interface/confirmation_003"], gain: 0.6 },

    // Airdrops: one comes down, and what each kind sounds like when caught.
    flotsam_in: { voice: "flotsam_in", files: ["kenney_interface/bong_001"], gain: 0.5 },
    claim_crate: {
      voice: "flotsam_claim",
      files: ["kenney_rpg/handleCoins"],
      gain: 0.65,
      trim: 0.7,
    },
    claim_fuel_drum: { voice: "rally", gain: 0.9 },
    claim_adrenaline: { voice: "rally", files: ["kenney_interface/maximize_006"], gain: 0.6 },
    // The Sealed Locker: a Supply Drop II lands (R3).
    claim_sealed_locker: { voice: "milestone", files: ["kenney_interface/confirmation_003"], gain: 0.6 },

    // Supply Drops and cards (R3 S3; D261): the crate creaks open, each card flips with a page
    // turn, a Rare or better adds its own sting on top; shards and gear click into place.
    drop_creak: {
      voice: "ui_open",
      files: ["kenney_rpg/creak1", "kenney_rpg/creak2", "kenney_rpg/creak3"],
      gain: 0.6,
    },
    card_flip: {
      voice: "ui_toggle",
      files: ["kenney_rpg/bookFlip1", "kenney_rpg/bookFlip2", "kenney_rpg/bookFlip3"],
      gain: 0.7,
      perSecond: 6,
    },
    card_common: { voice: "ui_toggle", files: ["kenney_interface/select_001"], gain: 0.3 },
    // R3 S4 (D267): a Supply Drop lands by the house (a wooden thud), a day's quest set or a
    // run's order set completes (a warm confirmation), a boost ignites, shards clink.
    drop_land: {
      voice: "milestone",
      files: ["kenney_impact/impactWood_heavy_000", "kenney_impact/impactWood_heavy_001", "kenney_impact/impactWood_heavy_002"],
      gain: 0.55,
    },
    set_done: { voice: "badge", files: ["kenney_interface/confirmation_004"], gain: 0.6 },
    boost: { voice: "rally", files: ["kenney_interface/maximize_008"], gain: 0.6 },
    shards: {
      voice: "ui_toggle",
      files: ["kenney_impact/impactGlass_light_000", "kenney_impact/impactGlass_light_001"],
      gain: 0.35,
      perSecond: 4,
    },
    card_rare: { voice: "milestone", files: ["kenney_interface/confirmation_003"], gain: 0.55 },
    card_epic: { voice: "badge", files: ["kenney_interface/maximize_004"], gain: 0.65 },
    card_legendary: { voice: "era", files: ["kenney_impact/impactBell_heavy_002"], gain: 0.75 },
    star: { voice: "milestone", files: ["kenney_interface/maximize_005"], gain: 0.6 },
    craft: { voice: "buy", files: ["kenney_rpg/handleSmallLeather"], gain: 0.7 },
    equip: { voice: "buy", files: ["kenney_rpg/cloth1"], gain: 0.7 },
    // A Work Order or a quest claimed (D256, D257): a short pick, then the drop's own sound.
    claim: { voice: "milestone", files: ["kenney_interface/select_005"], gain: 0.55 },

    // Frenzy trips (D237): a rising sting.
    frenzy: { voice: "frenzy", files: ["kenney_interface/maximize_008"], gain: 0.7 },
    // ...and burns out: the same sweep falling, quieter.
    frenzy_end: { voice: "ui_close", files: ["kenney_interface/minimize_008"], gain: 0.45 },
    // Crows (D238): a caw as one flies in, wings and coins when it is caught.
    gull_in: { voice: "caw", gain: 0.5 },
    gull_caught: { voice: "gull_caught", files: ["kenney_rpg/cloth3"], gain: 0.8 },
    // A badge (D198): a bright chime.
    badge: { voice: "badge", files: ["kenney_interface/confirmation_004"], gain: 0.6 },

    // Welcome back's Collect: the coins pour into the counter.
    collect: { voice: "milestone", files: ["kenney_rpg/handleCoins"], gain: 0.75 },

    // Sheets, switches and refusals.
    ui_open: { voice: "ui_open", files: ["kenney_interface/open_001"], gain: 0.35 },
    ui_close: { voice: "ui_close", files: ["kenney_interface/close_001"], gain: 0.35 },
    ui_switch: {
      voice: "ui_toggle",
      files: ["kenney_interface/toggle_001", "kenney_interface/toggle_002"],
      gain: 0.4,
      perSecond: 12,
    },
    refuse: { voice: "refuse", files: ["kenney_interface/error_004"], gain: 0.5, perSecond: 4 },

    // R4 S2, the Big Red (D270; 03-the-big-red.md 6-9; 08-screens.md 5.2): the hold's siren
    // rising over 2 s and winding down when let go; the launch's clunk; liftoff's roar; the
    // whistle home; the boom (low-passed noise and a 48 Hz sine); the sign's thunk; the
    // postcard's paper swish; the landing's oars and hop; the Kettle's stages (a plank, a
    // clank, a crate thud, the hiss of steam); the yield's quiet glass chime (one every 2 s);
    // Afterglow's warm shimmer. Procedural voices: no pack has a siren or a boom that fits.
    siren_rise: { voice: "siren_rise", gain: 0.5 },
    siren_down: { voice: "siren_down", gain: 0.5 },
    launch: { voice: "launch", files: ["kenney_impact/impactMetal_heavy_000"], gain: 0.7 },
    liftoff: { voice: "liftoff", gain: 0.6 },
    whistle: { voice: "whistle", gain: 0.45 },
    boom: { voice: "boom", gain: 0.9 },
    sign_thunk: { voice: "fell", files: ["kenney_impact/impactWood_heavy_002"], gain: 0.6 },
    postcard: { voice: "postcard", files: ["kenney_rpg/bookFlip2"], gain: 0.6 },
    landing: { voice: "landing", files: ["kenney_rpg/cloth2"], gain: 0.6 },
    kettle_pad: { voice: "buy", files: ["kenney_impact/impactPlank_medium_000"], gain: 0.6 },
    kettle_frame: { voice: "buy", files: ["kenney_impact/impactMetal_medium_000"], gain: 0.6 },
    kettle_warhead: { voice: "milestone", files: ["kenney_impact/impactWood_heavy_001"], gain: 0.6 },
    kettle_fuel: { voice: "steam", gain: 0.5 },
    glass_chime: {
      voice: "glass",
      files: ["kenney_impact/impactGlass_light_002", "kenney_impact/impactGlass_light_003"],
      gain: 0.35,
      perSecond: 1,
    },
    afterglow: { voice: "glass", files: ["kenney_interface/confirmation_002"], gain: 0.45 },
  },

  events: {
    // Predicted on the client, inside the tap's own gesture.
    tap_at: { cue: "tap_{target}" },
    crit: { cue: "crit" },
    felled: { cue: "fell_{target}", buzz: [20] },
    // The domain's events, as the client predicts them or the server pushes them.
    bought: { cue: "buy" },
    upgraded: { cue: "upgrade" },
    researched: { cue: "upgrade" },
    hand_hired: { cue: "hand" },
    era_reached: { cue: "era", buzz: [30, 50, 30] },
    era_ready: { cue: "era_ready" },
    flotsam_claimed: { cue: "claim_{kind}", buzz: [15] },
    frenzy_tripped: { cue: "frenzy", buzz: [20, 40, 20, 40, 60] },
    frenzy_ended: { cue: "frenzy_end" },
    boost_ended: { cue: "frenzy_end" },
    gull_caught: { cue: "gull_caught", buzz: [15] },
    badge_unlocked: { cue: "badge" },
    // R3's cards (S3, S4): the crate lands, creaks open, the cards flip and sting.
    drop_earned: { cue: "drop_land", buzz: [20] },
    drop_opened: { cue: "drop_creak", buzz: [20] },
    card_flipped: { cue: "card_{rarity}" },
    starred: { cue: "star", buzz: [15, 30, 15] },
    gear_crafted: { cue: "craft" },
    gear_equipped: { cue: "equip" },
    // R3 S2, S4: the Work Orders, the quests and scrap (D267: own cues for a set, a boost and shards).
    order_claimed: { cue: "claim", buzz: [15] },
    orders_fuelled: { cue: "set_done", buzz: [30, 50, 30] },
    quest_claimed: { cue: "claim", buzz: [15] },
    quest_set_done: { cue: "set_done", buzz: [30, 50, 30] },
    quests_rolled: null,
    scrap_earned: { cue: "collect" },
    shards_earned: { cue: "shards" },
    scrap_spent: { cue: "buy" },
    boost_bought: { cue: "boost", buzz: [20, 30, 40] },
    tide_claimed: { cue: "claim_{kind}", buzz: [15] },
    // The welcome card's Collect plays its own coins (`collected`).
    night_shift_collected: null,
    // The server's echo of taps already heard.
    tapped: null,
    // Seen on the welcome card instead.
    night_shift_over: null,
    base_reset: null,
    // R4 (D270): the press is the hold's end (the launch clunk and a 120 ms buzz); the film's
    // beats play from the scene on the wall clock; a node bought chimes; the admin's gifts are
    // quiet (a card says it).
    nuked: { cue: "launch", buzz: [120] },
    node_bought: { cue: "glass_chime" },
    granted: null,
    respecced: null,
    hold_started: { cue: "siren_rise" },
    hold_cancelled: { cue: "siren_down" },
    cine_liftoff: { cue: "liftoff" },
    cine_whistle: { cue: "whistle" },
    cine_boom: { cue: "boom", buzz: [300] },
    cine_sign: { cue: "sign_thunk" },
    postcard_shown: { cue: "postcard" },
    landed: { cue: "landing" },
    kettle_stage: { cue: "kettle_{stage}", buzz: [20] },
    yield_rose: { cue: "glass_chime" },
    afterglow_started: { cue: "afterglow" },
    // What the scene and the panels notice.
    milestone: { cue: "milestone", buzz: [15, 40, 15] },
    roster: { cue: "roster" },
    flotsam_arrived: { cue: "flotsam_in" },
    flotsam_lost: null,
    gull_arrived: { cue: "gull_in" },
    gull_lost: null,
    collected: { cue: "collect" },
    refused: { cue: "refuse" },
    go_tap: null,
    ui: { cue: "ui_{action}" },
  },
}
