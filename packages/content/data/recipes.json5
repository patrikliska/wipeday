// What can be made. `item` must exist in items.json5; `workbench` is the level needed
// (0 = bare hands); `craftMinutes` is the time in the queue (0 = ready at once). Cost is
// paid when the item is queued. One recipe makes one unit.
{
  recipes: [
    { item: "crate", workbench: 1, craftMinutes: 0, cost: { timber: 300 } },
    { item: "bandage", workbench: 1, craftMinutes: 0, cost: { fibre: 4 } },
    { item: "bow", workbench: 1, craftMinutes: 10, cost: { timber: 200, fibre: 50 } },
    { item: "hide_vest", workbench: 1, craftMinutes: 10, cost: { hide: 15, fibre: 10 } },
    { item: "large_crate", workbench: 2, craftMinutes: 10, cost: { timber: 500, ingots: 100 } },
    { item: "spear", workbench: 2, craftMinutes: 10, cost: { timber: 100, ingots: 25 } },
  ],
}
