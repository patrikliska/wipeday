// What the stations make. One recipe per output:
//   output  a part (resources.json5, lands in stock) or an item (items.json5)
//   amount  how many one unit makes (default 1)
//   station the building that makes it; level: the building level it needs
//   minutes per unit, before the lights' speed-up
//   cost    per unit, paid up front for the whole batch
//   blueprint: true = known only once a blueprint is found. Only extras: parts never.
{
  recipes: [
    // Parts.
    { output: "planks", amount: 10, station: "workbench", level: 1, minutes: 2, cost: { timber: 60 } },
    { output: "rope", amount: 5, station: "loom", level: 1, minutes: 3, cost: { fibre: 30 } },
    { output: "cloth", amount: 5, station: "loom", level: 1, minutes: 4, cost: { fibre: 40 } },
    { output: "leather", amount: 2, station: "tannery", level: 1, minutes: 5, cost: { hide: 6, fat: 1 } },
    { output: "charcoal", amount: 10, station: "kiln", level: 1, minutes: 4, cost: { timber: 50 } },
    { output: "fuel", amount: 5, station: "press", level: 1, minutes: 4, cost: { fat: 10 } },
    { output: "plates", amount: 5, station: "workbench", level: 2, minutes: 5, cost: { ingots: 40 } },
    { output: "frames", amount: 2, station: "workbench", level: 2, minutes: 5, cost: { planks: 10, ingots: 8 } },
    { output: "gears", amount: 2, station: "workbench", level: 2, minutes: 6, cost: { ingots: 20 } },
    { output: "springs", amount: 2, station: "workbench", level: 3, minutes: 8, cost: { ingots: 16, charcoal: 10 } },

    // Storage.
    { output: "crate", station: "workbench", level: 1, minutes: 5, cost: { planks: 30 } },
    { output: "large_crate", station: "workbench", level: 2, minutes: 15, cost: { planks: 60, plates: 10 } },
    { output: "strongbox", station: "workbench", level: 2, minutes: 30, cost: { frames: 10, plates: 20 }, blueprint: true },

    // Medicine.
    { output: "bandage", station: "loom", level: 1, minutes: 2, cost: { cloth: 2 } },
    { output: "first_aid_kit", station: "workbench", level: 2, minutes: 10, cost: { cloth: 6, fat: 4, leather: 2 }, blueprint: true },

    // Gear (the crew carries it from W4).
    { output: "bow", station: "workbench", level: 1, minutes: 10, cost: { planks: 10, rope: 5 } },
    { output: "spear", station: "workbench", level: 2, minutes: 10, cost: { planks: 10, ingots: 25 } },
    { output: "leather_vest", station: "tannery", level: 1, minutes: 15, cost: { leather: 8, cloth: 4 } },
    { output: "crossbow", station: "workbench", level: 3, minutes: 30, cost: { planks: 20, springs: 4, rope: 10 }, blueprint: true },

    // Meals, cooked at the campfire (the kitchen from level 3).
    { output: "roast", station: "campfire", level: 1, minutes: 10, cost: { food: 30 } },
    { output: "stew", station: "campfire", level: 2, minutes: 20, cost: { food: 60, fibre: 10 } },
    { output: "feast", station: "campfire", level: 3, minutes: 30, cost: { food: 120, fuel: 5 }, blueprint: true },
  ],
}
