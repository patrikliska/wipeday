// The legacy layer (W7): what a player keeps when the season resets, and what legacy points
// buy. Names and lines are in the locale (`perk.{id}.*`, `skin.{id}.*`, `legacy.*`).
{
  // Points a finished season gives: for playing it at all, by place in each leaderboard
  // category (1st, 2nd, 3rd, 4th), and up to `signal` for a share of the Signal's gifts.
  points: { played: 3, place: [5, 3, 2, 1], signal: 10 },
  // No perk tree may make a veteran more than this percent stronger than a new player in
  // any rate (CLAUDE.md section 8). The content check sums every perk at its top rank.
  capPercent: 25,
  // Perks: `bonus` is what one rank adds (the effects below), `cost` the points for each
  // rank in turn. Options instead: `returning` (the best veteran not in the starting crew is
  // home from day one), `crate` (a storage crate from day one).
  //   allRates    percent more of every gathered resource
  //   capPercent  percent more room for every resource
  //   craftPercent / smeltPercent  percent faster stations / furnaces
  //   tripSuccess points of success on every trip
  //   xpPercent   percent more crew XP from trips
  perks: [
    { id: "steady_hands", bonus: { allRates: 2 }, cost: [3, 5, 8] },
    { id: "deep_cellars", bonus: { capPercent: 3 }, cost: [3, 5, 8] },
    { id: "quick_fingers", bonus: { craftPercent: 3 }, cost: [3, 5, 8] },
    { id: "hot_coals", bonus: { smeltPercent: 3 }, cost: [3, 5, 8] },
    { id: "old_maps", bonus: { tripSuccess: 2 }, cost: [4, 6] },
    { id: "war_stories", bonus: { xpPercent: 6 }, cost: [3, 5, 8] },
    { id: "old_friend", bonus: {}, returning: true, cost: [6] },
    { id: "packed_crate", bonus: {}, crate: true, cost: [4] },
  ],
  // Base skins: a palette for the holdfast, earned, never bought.
  //   season   finish this many seasons
  //   defended hold off this many raids in one season
  //   signal   be on the island when the Signal is lit
  skins: [
    { id: "driftwood", season: 1 },
    { id: "rust", defended: 10 },
    { id: "beacon", signal: true },
  ],
}
