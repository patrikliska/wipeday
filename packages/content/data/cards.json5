// Survivor and gear cards, the sets and the Supply Drops (docs/redesign/12-feel.md 7; R3 Cards;
// D248-D250). The run never needs a card: a hand is hired with Supplies as before. Owning its
// survivor card adds, while the hand is hired: +perStar of its line's output per star above 1
// (×2 at five stars), its trait, and the gear it wears (three slots, all open at once).
//
// A card names a stat and a value; the op and how far each rarity may go are in
// content/src/cards.ts (CARD_STATS: output, speed and offline, the line's output while away,
// reach the holder's own line; night_shift, in hours, the whole island). Names: `crew.{id}.name`, `trait.{id}.name`,
// `gear.{id}.name`, `set.{id}.name`, `rarity.{id}.name`.
{
  stars: { costs: [10, 25, 50, 100], perStar: 0.25 },
  shards: {
    // A duplicate survivor pays its own shards (a five-star one pays gear shards of its rarity).
    survivor: { common: 5, rare: 8, epic: 12, legendary: 20 },
    gear: { common: 4, rare: 10, epic: 25, legendary: 60 },
    craft: { common: 20, rare: 50, epic: 120, legendary: 300 },
  },
  drops: {
    cards: 3,
    // The first drop's first card, printed on the odds page (12-feel.md 10: "first survivor
    // reveal (Mara)").
    first: "mara",
    tiers: [
      { odds: { common: 70, rare: 25, epic: 4.5, legendary: 0.5 } },
      { odds: { common: 45, rare: 40, epic: 13, legendary: 2 } },
      { odds: { common: 10, rare: 50, epic: 32, legendary: 8 } },
    ],
    pity: { rare: 10, epic: 40, legendary: 150 },
    // Felling pays a tier-I drop at these lifetime fells, then every `every`, at most one every
    // `gapMinutes` and `perDay` an island day (everyone stays in run 1 until R4, so "every 5th
    // fell" would flood, and an active player fells eight times as often as a casual one; D249).
    fells: { at: [5], every: 25, gapMinutes: 60, perDay: 3 },
    badgesPer: 10,
  },
  survivors: [
    { id: "mara", rarity: "common", trait: { stat: "night_shift", value: 0.1667 } },
    { id: "dax", rarity: "common", trait: { stat: "output", value: 1.2 } },
    { id: "ivo", rarity: "common", trait: { stat: "output", value: 1.25 } },
    { id: "rook", rarity: "rare", trait: { stat: "speed", value: 1.2 } },
    { id: "sela", rarity: "rare", trait: { stat: "speed", value: 1.2 } },
    { id: "bram", rarity: "common", trait: { stat: "offline", value: 1.25 } },
    { id: "wren", rarity: "rare", trait: { stat: "speed", value: 1.1111 } },
    { id: "otto", rarity: "common", trait: { stat: "output", value: 1.2 } },
    { id: "juno", rarity: "rare", trait: { stat: "output", value: 1.25 } },
    { id: "pike", rarity: "rare", trait: { stat: "offline", value: 1.25 } },
    { id: "hale", rarity: "epic", trait: { stat: "night_shift", value: 0.25 } },
    { id: "tamsin", rarity: "epic", trait: { stat: "speed", value: 1.25 } },
    { id: "gus", rarity: "epic", trait: { stat: "output", value: 1.25 } },
    { id: "vera", rarity: "legendary", trait: { stat: "speed", value: 1.25 } },
  ],
  gear: [
    // Hand: tools.
    { id: "salvaged_hatchet", rarity: "common", slot: "hand", effect: { stat: "output", value: 1.2 } },
    { id: "crowbar", rarity: "common", slot: "hand", effect: { stat: "output", value: 1.2 } },
    { id: "pipe_wrench", rarity: "common", slot: "hand", effect: { stat: "speed", value: 1.2 } },
    { id: "work_gloves", rarity: "common", slot: "hand", effect: { stat: "speed", value: 1.2 } },
    { id: "claw_hammer", rarity: "rare", slot: "hand", effect: { stat: "output", value: 1.3 } },
    { id: "hand_drill", rarity: "rare", slot: "hand", effect: { stat: "speed", value: 1.3 } },
    { id: "bolt_cutters", rarity: "rare", slot: "hand", effect: { stat: "output", value: 1.3 } },
    { id: "chainsaw", rarity: "epic", slot: "hand", effect: { stat: "output", value: 1.45 } },
    { id: "welding_torch", rarity: "epic", slot: "hand", effect: { stat: "speed", value: 1.45 } },
    { id: "power_saw", rarity: "legendary", slot: "hand", effect: { stat: "output", value: 1.6 } },
    // Head.
    { id: "tin_lantern", rarity: "common", slot: "head", effect: { stat: "night_shift", value: 0.2 } },
    { id: "bandana", rarity: "common", slot: "head", effect: { stat: "offline", value: 1.2 } },
    { id: "welding_goggles", rarity: "common", slot: "head", effect: { stat: "speed", value: 1.2 } },
    { id: "hard_hat", rarity: "common", slot: "head", effect: { stat: "output", value: 1.2 } },
    { id: "gas_mask", rarity: "rare", slot: "head", effect: { stat: "output", value: 1.3 } },
    { id: "headlamp", rarity: "rare", slot: "head", effect: { stat: "night_shift", value: 0.3 } },
    { id: "ear_defenders", rarity: "rare", slot: "head", effect: { stat: "offline", value: 1.3 } },
    { id: "night_goggles", rarity: "epic", slot: "head", effect: { stat: "night_shift", value: 0.45 } },
    { id: "hazmat_hood", rarity: "epic", slot: "head", effect: { stat: "output", value: 1.45 } },
    { id: "spotter_scope", rarity: "legendary", slot: "head", effect: { stat: "speed", value: 1.6 } },
    // Pack: what is carried and worn on the back.
    { id: "rope_belt", rarity: "common", slot: "pack", effect: { stat: "offline", value: 1.2 } },
    { id: "jerrycan", rarity: "common", slot: "pack", effect: { stat: "output", value: 1.2 } },
    { id: "car_battery", rarity: "common", slot: "pack", effect: { stat: "night_shift", value: 0.2 } },
    { id: "tool_roll", rarity: "common", slot: "pack", effect: { stat: "speed", value: 1.2 } },
    { id: "satchel", rarity: "rare", slot: "pack", effect: { stat: "speed", value: 1.3 } },
    { id: "water_flask", rarity: "rare", slot: "pack", effect: { stat: "offline", value: 1.3 } },
    { id: "tarp_bundle", rarity: "rare", slot: "pack", effect: { stat: "output", value: 1.3 } },
    { id: "hazmat_coat", rarity: "epic", slot: "pack", effect: { stat: "output", value: 1.45 } },
    { id: "flare_pouch", rarity: "epic", slot: "pack", effect: { stat: "offline", value: 1.45 } },
    { id: "generator_pack", rarity: "legendary", slot: "pack", effect: { stat: "offline", value: 1.6 } },
  ],
  sets: {
    crews: [
      // All five Common survivors at three stars: Twig and Timber lines ×1.5.
      {
        id: "common_crew",
        rarity: "common",
        stars: 3,
        effects: [
          { stat: "output", op: "more", value: 1.5, scope: "twig" },
          { stat: "output", op: "more", value: 1.5, scope: "wood" },
        ],
      },
      // All 14 survivors owned: Morale +10%.
      { id: "full_crew", stars: 1, effects: [{ stat: "morale", op: "more", value: 1.1 }] },
    ],
    // A hired survivor wearing three gear cards of one rarity: that line +10%.
    kit: { id: "matched_kit", pieces: 3, effect: { stat: "output", value: 1.1 } },
  },
}
