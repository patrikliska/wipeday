// The shelf beside Grip (docs/redesign/02-the-run.md 5.3 and 5.4).
// Line Mk: one rule each, generated for every line as `{line}_mk2` and `{line}_mk3`, price the
// line's first unit × costFactor, needing needOwned of the line; Mk III comes after Mk II
// (D152). Island upgrades: each after the one before, so the shelf shows at most one.
// Names: `upgrade.{id}.name`. Pocket-eligible from R5.
{
  lineMk: [
    {
      id: "mk2",
      costFactor: 1e4,
      needOwned: 25,
      pocket: true,
      effects: [{ stat: "output", op: "more", value: 3 }],
    },
    {
      id: "mk3",
      costFactor: 1e8,
      needOwned: 50,
      pocket: true,
      effects: [{ stat: "output", op: "more", value: 3 }],
    },
  ],
