// What a survivor is good at: two each (crew.json5). Names and one-line effects are in the
// locale (`trait.{id}.name`, `.effect`). Most effects apply to trips and scouting (W4a); the
// last three to jobs at home (W4b).
//   success   + percentage points of success chance, anywhere
//   hazard    + points of success at sites with that hazard (hostile, blocked, unstable, flooded)
//   loot      + percent more of every loot amount
//   lootRolls + extra loot rolls on a trip
//   tripTime  percent shorter trips and scouting
//   injury    percent lower injury chance for the whole party (medic, cautious)
//   recovery  percent faster healing of this survivor's injuries
//   rare      percent higher chance of blueprints and map fragments
//   job       percent more output on a node job
//   craft     percent faster crafting on a station job, by station id (or `any`)
//   guard     defence points on guard duty
{
  traits: [
    { id: "scavenger", loot: 20 },
    { id: "mule", lootRolls: 1, job: 15 },
    { id: "navigator", tripTime: 15, hazard: { flooded: 10 } },
    { id: "marksman", hazard: { hostile: 15 }, guard: 5 },
    { id: "demolition", hazard: { blocked: 15 } },
    { id: "medic", injury: 30, recovery: 40 },
    { id: "cautious", injury: 25, hazard: { unstable: 10 } },
    { id: "brave", success: 8, guard: 3 },
    { id: "lucky", rare: 50 },
    { id: "cook", craft: { campfire: 50 } },
    { id: "tinkerer", craft: { any: 30 } },
  ],
}
