// The island (season 1 layout; W7 varies it per season). Every player plays the same
// island under their own fog. x, y: the region's centre on a 1000 x 1000 map (north up).
// ring: distance from the holdfast; ring 0 is known from the start. A region can be scouted
// when it borders a known one and its ring is within the base tier's `range`. terrain: how the map draws it.
// scout: the fee and the time a scout needs. Names and blurbs are in the locale
// (`region.{id}.name`, `.blurb`). access "sea": reached by boat only (W4b): the dock
// (`boatBuilding`, at level `dock`, 1 when not given) and a navigator (`boatTrait`) in every
// party; their fees carry fuel.
{
  rules: {
    // A stronger holdfast can supply longer trips: the highest ring a scout reaches, by tier.
    // The radio mast adds one more ring (buildings.json5 `scoutRange`).
    range: { twig: 1, wood: 1, stone: 2, metal: 3, hqm: 4 },
    // Most survivors in one party.
    maxParty: 3,
    boatBuilding: "dock",
    boatTrait: "navigator",
    // Bad luck is capped: after this many successes at a site without its find (a keycode),
    // the next success brings it.
    findPity: 3,
  },
  regions: [
    {
      id: "landing", x: 500, y: 820, ring: 0, terrain: "shore",
      neighbours: ["tidal_flats", "pine_ridge", "ferry_point"],
      scout: { cost: {}, minutes: 1 },
    },
    {
      id: "tidal_flats", x: 285, y: 800, ring: 1, terrain: "marsh",
      neighbours: ["landing", "pine_ridge", "rust_bay"],
      scout: { cost: { food: 20 }, minutes: 20 },
    },
    {
      id: "pine_ridge", x: 520, y: 620, ring: 1, terrain: "forest",
      neighbours: ["landing", "tidal_flats", "quarry_hills", "ferry_point", "stormcap"],
      scout: { cost: { food: 20, scrap: 5 }, minutes: 30 },
    },
    {
      id: "ferry_point", x: 790, y: 760, ring: 2, terrain: "ruins",
      neighbours: ["landing", "pine_ridge", "stormcap"],
      scout: { cost: { food: 40, scrap: 15 }, minutes: 60 },
    },
    {
      id: "rust_bay", x: 150, y: 610, ring: 2, terrain: "shore",
      neighbours: ["tidal_flats", "quarry_hills", "sulfur_springs", "the_narrows"],
      scout: { cost: { food: 40, scrap: 15 }, minutes: 60 },
    },
    {
      id: "quarry_hills", x: 360, y: 480, ring: 2, terrain: "hills",
      neighbours: ["pine_ridge", "rust_bay", "sulfur_springs", "signal_hill"],
      scout: { cost: { food: 50, scrap: 20 }, minutes: 75 },
    },
    {
      id: "stormcap", x: 800, y: 520, ring: 3, terrain: "cliffs",
      neighbours: ["pine_ridge", "ferry_point", "signal_hill", "north_dam"],
      scout: { cost: { food: 80, scrap: 40, fuel: 5 }, minutes: 150 },
    },
    {
      id: "sulfur_springs", x: 200, y: 330, ring: 3, terrain: "marsh",
      neighbours: ["rust_bay", "quarry_hills", "signal_hill", "rail_yards"],
      scout: { cost: { food: 80, scrap: 40, fuel: 5 }, minutes: 150 },
    },
    {
      id: "signal_hill", x: 560, y: 320, ring: 3, terrain: "hills",
      neighbours: ["quarry_hills", "stormcap", "sulfur_springs", "rail_yards", "north_dam"],
      scout: { cost: { food: 100, scrap: 50, fuel: 5 }, minutes: 180 },
    },
    // The far north (ring 4): a Sheet Metal base with a radio mast, or an Armored one.
    {
      id: "rail_yards", x: 370, y: 215, ring: 4, terrain: "tundra",
      neighbours: ["sulfur_springs", "signal_hill", "north_dam"],
      scout: { cost: { food: 150, scrap: 80, fuel: 15 }, minutes: 240 },
    },
    {
      id: "north_dam", x: 710, y: 245, ring: 4, terrain: "tundra",
      neighbours: ["signal_hill", "stormcap", "rail_yards"],
      scout: { cost: { food: 160, scrap: 90, fuel: 15 }, minutes: 270 },
    },
    // The sea: by boat from the dock.
    {
      id: "the_narrows", x: 35, y: 440, ring: 4, terrain: "sea", access: "sea", dock: 2,
      neighbours: ["rust_bay", "open_water"],
      scout: { cost: { food: 120, scrap: 60, fuel: 30 }, minutes: 360 },
    },
    {
      id: "open_water", x: 55, y: 240, ring: 5, terrain: "sea", access: "sea", dock: 3,
      neighbours: ["the_narrows"],
      scout: { cost: { food: 200, scrap: 100, fuel: 60 }, minutes: 1440 },
    },
  ],
}
