  ceilings: { tap: 1.5, tap_share: 0.0031, hustle_max: 0.25, night_shift: 12, glass_gain: 1.27, glow_k: 0.03, offline: 1, flotsam_rate: 1.05, flotsam_effect: 1.05 },
