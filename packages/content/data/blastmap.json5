// The Blast Map (docs/redesign/04-blast-map.md; the catalog 04b-blast-map.json; D268): Ground
// Zero and eight sectors of 45°, nine rings of 2, 3, 4, 5, 5, 6, 6, 7, 7 nodes. Wave 1 (rings
// 1-3, 73 nodes) ships in R4; rings 4-6 join in R5, 7-9 in R9 (`shippedWave`). A node's
// `requires` are OR (one owned parent is enough); every edge comes from the previous ring of the
// same sector. Costs sit on one ladder of playful numbers (`prices`, ×10 a ring). Names and
// blurbs: `node.{id}.name` / `.blurb`; sectors `sector.{id}.name` / `.tagline`. The ceilings
// are what all shipped non-keystone nodes may add together (04 4.2), checked by the content.
{
  sectors: ["grip", "crew", "works", "tide", "bunker", "blast", "logbook", "scrapyard"],
  shippedWave: 1,
  rings: [
    { ring: 1, size: 2, band: [1, 2] },
    { ring: 2, size: 3, band: [4, 10] },
    { ring: 3, size: 4, band: [25, 75] },
    { ring: 4, size: 5, band: [200, 600] },
    { ring: 5, size: 5, band: [2000, 6000] },
    { ring: 6, size: 6, band: [20000, 60000] },
    { ring: 7, size: 6, band: [200000, 600000] },
    { ring: 8, size: 7, band: [2000000, 6000000] },
    { ring: 9, size: 7, band: [20000000, 60000000] },
  ],
  prices: [1, 2, 3, 4, 5, 7, 9, 11, 15, 19, 25, 33, 44, 55, 66, 77, 99, 111, 150, 222, 333, 444, 555, 777, 999, 1111, 2222, 3333, 4444, 5555, 7777, 9999, 11100, 22200, 33300, 44400, 55500, 77700, 99900, 111000, 222000, 333000, 444000, 555000, 777000, 999000, 1110000, 2220000, 3330000, 4440000, 5550000, 7770000, 9990000, 11100000, 22200000, 33300000, 44400000, 55500000, 77700000, 99900000, 111000000],
  typeFactor: { small: 1, notable: 2, keystone: 3, unlock: 1, automation: 1, completion: 1 },
