// Everything that can sit in the inventory. Names and one-line effects are in the locale
// (`item.{id}.name`, `item.{id}.effect`). Recipes are in recipes.json5.
// tier: rarity on the base-tier colour scale (and salvage scrap). capacity: storage items
// add this to every resource's cap. unique: a base holds at most one. Meals: served, they
// add boostPercent to Gather and node hits for `hours`. Gear: a survivor carries one weapon
// (power: success points at hostile sites) and one armour (protection: percent less injury).
{
  items: [
    { id: "crate", category: "storage", tier: "wood", capacity: 1000 },
    { id: "large_crate", category: "storage", tier: "stone", capacity: 4000 },
    { id: "strongbox", category: "storage", tier: "metal", capacity: 9000 },
    { id: "bandage", category: "med", tier: "twig" },
    { id: "first_aid_kit", category: "med", tier: "stone" },
    { id: "bow", category: "weapon", tier: "wood", power: 10 },
    { id: "spear", category: "weapon", tier: "stone", power: 8 },
    { id: "crossbow", category: "weapon", tier: "metal", power: 18 },
    { id: "leather_vest", category: "armor", tier: "stone", protection: 30 },
    { id: "roast", category: "meal", tier: "wood", boostPercent: 10, hours: 4 },
    { id: "stew", category: "meal", tier: "stone", boostPercent: 20, hours: 6 },
    { id: "feast", category: "meal", tier: "metal", boostPercent: 30, hours: 8 },
  ],
}
